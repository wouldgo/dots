{{ if eq .chezmoi.os "linux" -}}
{{- $nvidia := contains "0x10de" (includeTemplate "gpu-vendors" .) -}}
#!/usr/bin/env bash
set -euo pipefail

# sway refuses to start on the proprietary NVIDIA driver without
# --unsupported-gpu, so the stock "Sway" session drops back to the login
# screen. Extra login entry "Sway (NVIDIA)" with the flag, only with an NVIDIA
# GPU (nvidia: {{ $nvidia }}).
# /usr/local/share: outside package-owned paths, still read by GDM.
session=/usr/local/share/wayland-sessions/sway-nvidia.desktop
{{ if $nvidia -}}
sudo mkdir -p "$(dirname "${session}")"
sudo tee "${session}" >/dev/null <<'DESKTOP'
[Desktop Entry]
Name=Sway (NVIDIA)
Comment=An i3-compatible Wayland compositor, on the proprietary NVIDIA driver
Exec=sway --unsupported-gpu
Type=Application
DesktopNames=sway
DESKTOP
{{- else -}}
sudo rm -f "${session}"
{{- end }}
{{ end -}}
