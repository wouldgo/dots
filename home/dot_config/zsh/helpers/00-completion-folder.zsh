#!/usr/bin/env zsh

ZSH_COMPLETION_FOLDER="${HOME}/.config/zsh/completion"

function __zsh_completion_bootstrap () {
  if [ ! -d "$ZSH_COMPLETION_FOLDER" ]; then
    mkdir --parents "${ZSH_COMPLETION_FOLDER}"
  fi

  # completions
  fpath+=( "${ZSH_COMPLETION_FOLDER}" )

  # compinit must run before `mise activate` (00-mise.zsh): mise's hook-env
  # runs its own `compinit -i` when compdef is not yet defined.
  autoload -Uz compinit && compinit
  autoload -Uz bashcompinit && bashcompinit
}

# Registers completion files generated by the helpers after compinit already ran
# (e.g. first boot), reading their `#compdef` line as compinit would.
function __zsh_completion_register_new () {
  local FILE
  local NAME
  local -a COMPDEF_LINE

  for FILE in "${ZSH_COMPLETION_FOLDER}"/_*(N-.); do
    NAME="${FILE:t}"
    (( $+functions[${NAME}] )) && continue

    read -r -A COMPDEF_LINE < "${FILE}"
    [[ "${COMPDEF_LINE[1]}" == "#compdef" ]] || continue

    autoload -Uz "${NAME}"
    compdef "${NAME}" "${(@)COMPDEF_LINE[2,-1]}"
  done
}

__zsh_completion_bootstrap
