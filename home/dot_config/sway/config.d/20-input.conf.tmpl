# --- Input --------------------------------------------------------------------
# List devices with: swaymsg -t get_inputs

input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 40
}
{{- if .isLaptop }}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
}
{{- end }}

# Focus does not jump around when the mouse crosses window borders
focus_follows_mouse no
