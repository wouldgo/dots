# Defaults baked into the ISO. No secrets here.
# Override order (last wins): this file < QEMU fw_cfg opt/autoinstall < kernel
# cmdline autoinstall.<key>=<value>. Keys left empty are prompted for.

# Target disk: empty = interactive pick, "auto" = first NVMe, then virtio, then SATA/USB
DISK=
HOSTNAME=
USERNAME=dario
FULLNAME=
TIMEZONE=Europe/Rome
LANG=en_US.UTF-8
LOCALES=en_US.UTF-8,it_IT.UTF-8
KEYMAP=us
# LUKS2 on the root partition: true, false, or empty = ask (default answer yes)
LUKS=
# Swapfile in the @swap subvolume, 0 = none
SWAP_SIZE=8g
# Gaming apps by chezmoi (Steam, Sunshine, GE-Proton): true, false, or empty = ask (default answer no)
GAMING=
# Comma separated, passed to reflector --country (empty = worldwide)
MIRROR_COUNTRY=Italy,Germany,France
DOTS_REPO=https://github.com/wouldgo/dots.git
DOTS_PUSH_URL=git@github.com:wouldgo/dots.git
DOTS_REF=feature/chezmoi
POWEROFF=true

# Unattended runs only (QEMU tests), never in this file:
#   PASSWORD_HASH=<openssl passwd -6 output>
#   LUKS_PASSPHRASE=<plain text>
